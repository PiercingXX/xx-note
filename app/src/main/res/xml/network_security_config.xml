<?xml version="1.0" encoding="utf-8"?>
<!--
  One host means one host (R8). Cleartext is forbidden everywhere; TLS
  anchors to the system store only, so the Tailscale-issued Let's Encrypt
  certificate on the NAS validates with no pinning and no user CA.

  Deliberately NO <domain-config> (hardening #11): the NAS host is chosen at
  runtime, so a domain entry here could never match anything. The security
  claim rides entirely on <base-config> above plus OneHostInterceptor, which
  WebDavClient installs as an application interceptor pinning every request
  to the configured scheme://host:port with redirects disabled — a request
  for any other origin throws before a socket is opened. Never widen this
  file: no extra domains, no user CAs, no cleartext exceptions.
-->
<network-security-config>

    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>

</network-security-config>
