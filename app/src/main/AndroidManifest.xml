<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The short list is the claim (R8): one network permission, one camera
         permission, and nothing that runs on its own schedule except a sync. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- androidx.work merges infrastructure permissions into every consumer.
         FOREGROUND_SERVICE is genuinely unused here: expedited syncs fall back
         to regular work (RUN_AS_NON_EXPEDITED_WORK_REQUEST), never a foreground
         service (§4.4) — stripped to keep the audit line honest.
         WAKE_LOCK and RECEIVE_BOOT_COMPLETED remain because periodic sync is
         real: MainActivity enqueues the 15-minute pass at app start whenever a
         credential row exists, and Setup enqueues on completion (design §4.4).
         RECEIVE_BOOT_COMPLETED is WorkManager's boot-persistence mechanism —
         without it the periodic pass would not survive a reboot until the next
         app open. OPERATOR VETO POINT: if the four-permission claim must be
         absolute, remove these two too and accept that periodic sync waits
         until first app open after a reboot. -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE"
        tools:node="remove"/>
    <!-- deliberately NO storage permissions of any kind (D14): the vault lives
         in filesDir, app-private, invisible to Storage Scopes -->
    <!-- deliberately NO exact alarms — reminders are a v1 non-goal -->
    <!-- Camera is optional (§13): requested at first capture, app fully usable
         when denied — so the hardware feature must not be implied-required. -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false"/>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.XxNote"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules">

        <!-- Backup/extraction posture (R8, hardening #4): allowBackup is false
             outright, and data_extraction_rules additionally excludes every
             domain from both cloud-backup and device-to-device transfer on
             12+. The vault (filesDir) and the Room DB holding the sealed
             credential blob never leave the device — the Keystore key cannot
             be backed up, so a restored blob would be unopenable anyway. -->

        <!-- Single launcher activity; Compose only (D11). No exported
             components beyond this one (design §13). -->
        <activity
            android:name=".MainActivity"
            android:launchMode="singleTop"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- Family-wide theme sync (receiver side): the xx-launcher
             broadcasts xx.launcher.THEME_CHANGED explicitly targeted at this
             package (required since Android O for manifest receivers), so
             exported=true here only admits senders that already name us.
             The receiver persists the preset and restyles a running UI. -->
        <receiver
            android:name=".ui.theme.ThemeSyncReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="xx.launcher.THEME_CHANGED"/>
            </intent-filter>
        </receiver>

        <!-- Shipped: SyncWorker under WorkManager since WS5 — it needs no
             manifest entry of its own; WorkManager's provider/services/
             receivers merge in below. FileProvider (P2.12): hands the camera
             app a content URI for TakePicture captures only — exported=false,
             grantUriPermissions-scoped, paths limited to the app-private
             cache dir (res/xml/file_paths). Deliberately NO BootReceiver —
             WorkManager persists periodic work across reboots; keeps the
             four-permission claim intact. -->

        <!-- P2.12 camera capture: the one shared-content surface in the app.
             Authority is ${applicationId}-scoped; nothing else may read it. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"/>
        </provider>

    </application>

</manifest>
